{
    "builds": [
        { "src": "api/**/*.php", "use": "vercel-php@0.9.0" }
    ],
    "routes": [
        { "handle": "filesystem" },
        { "src": "/demo/?", "dest": "/api/demo/index.php" },
        { "src": "/demo/(.+)", "dest": "/api/demo/vercel-static.php" },
        { "src": "/", "dest": "/api/index.php" }
    ]
}
